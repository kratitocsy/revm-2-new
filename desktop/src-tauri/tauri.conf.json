{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "revm2-desktop",
  "version": "0.1.0",
  "identifier": "com.kiaro.revm2-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "revm2-desktop",
        "width": 800,
        "height": 600,
      "url": "https://revm-2-new.vercel.app"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
