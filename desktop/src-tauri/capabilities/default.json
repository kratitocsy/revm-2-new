{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://revm-2-new.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    "allow-greet",
    "allow-set-tray-status",
    "allow-set-session-active",
    "allow-set-schedule-active",
    "allow-debug-browser-status",
    "allow-push-session-event",
    "allow-list-running-apps",
    "allow-get-blocked-apps",
    "allow-set-blocked-apps",
    "allow-gate-protection-start",
    "allow-gate-protection-stop"
  ]
}
