{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "allow-greet",
    "allow-set-session-active",
    "allow-debug-browser-status",
    "allow-set-tray-status"
  ]
}
