{
  "name": "revm2",
  "private": true,
  "version": "1.0.0",
  "description": "RevM² — study accountability platform (web app + shared build)",
  "type": "module",
  "scripts": {
    "build:shared": "vite build --config vite.shared.config.js",
    "dev:shared": "vite build --config vite.shared.config.js --watch",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.build.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.build.css --watch",
    "build:sidebars": "node scripts/build-sidebars.js",
    "dev:mobile-home": "vite --config vite.mobile-home.config.js",
    "build:mobile-home": "npm run build:css && vite build --config vite.mobile-home.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
