{
  "name": "revm2",
  "private": true,
  "version": "1.0.0",
  "description": "RevM² — study accountability platform (web app + shared build)",
  "type": "module",
  "scripts": {
    "build:shared": "vite build --config vite.shared.config.js",
    "dev:shared": "vite build --config vite.shared.config.js --watch",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.build.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.build.css --watch",
    "build:sidebars": "node scripts/build-sidebars.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0"
  }
}
